{
  "name": "internflow",
  "version": "0.1.0",
  "description": "Turn local development activity into scheduled, structured work records.",
  "type": "module",
  "bin": {
    "internflow": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "web": "tsx src/cli.ts web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "worklog",
    "daily-report",
    "lark",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
